# ==============================================================================
# Forté Arena - Production Environment Variables Template
# ==============================================================================
# Copy this template to set your environment variables on Vercel or your hosting platform.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# MUST CHANGE: Point to your production database instance.
# Connection pooled transaction URL (for Next.js serverless functions / pgbouncer):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session connection URL (for Prisma CLI migrations):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. BETTER AUTH (Authentication & Sessions)
# ------------------------------------------------------------------------------
# MUST CHANGE: Generate a brand-new, cryptographically secure 32+ character secret!
# Run: `openssl rand -base64 32` or `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
# NEVER reuse the local development secret in production.
BETTER_AUTH_SECRET="<GENERATE_NEW_RANDOM_32_BYTE_SECRET>"

# MUST CHANGE: Production canonical URL (without trailing slash).
# Example: https://forte-arena.vercel.app or https://events.yourdomain.edu
BETTER_AUTH_URL="https://your-production-domain.com"

# MUST CHANGE: Public-facing domain for client-side API calls & Open Graph metadataBase.
# Usually matches BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# OPTIONAL: Additional trusted origins for cross-domain auth (comma-separated, no spaces).
# Example: "https://forte-arena.vercel.app,https://events.yourdomain.edu"
BETTER_AUTH_TRUSTED_ORIGINS="https://your-production-domain.com"

# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE (Posters & Certificates)
# ------------------------------------------------------------------------------
# MUST CHANGE: Production Supabase project URL and Service Role Key.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY>"

# Storage bucket for event posters and certificate images (must exist in Supabase):
SUPABASE_STORAGE_BUCKET="event-media"

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH (Optional Social Login)
# ------------------------------------------------------------------------------
# OPTIONAL: Required only if Google Sign-In is enabled in production.
# Callback URL to configure in Google Cloud Console: https://<domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of organizer/admin emails automatically granted ORGANIZER role on signup:
ORGANIZER_EMAILS="admin@yourdomain.edu,organizer@yourdomain.edu"

# Timezone for date displays (e.g. Asia/Karachi, America/New_York, UTC):
APP_TIMEZONE="Asia/Karachi"

# Node environment:
NODE_ENV="production"
